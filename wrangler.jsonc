// Cloudflare Worker: serves ./site (built by `npm run build`) and runs the online rooms
// (server/worker.js). Deployed by Workers Builds on every push to the main branch.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catan-3d",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PresenceRoom" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PresenceRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] }
  ],
  "observability": { "enabled": true }
}
